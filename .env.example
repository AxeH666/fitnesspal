# PostgreSQL (used by Docker Compose and the backend)
POSTGRES_DB=barbarik_fitness
POSTGRES_USER=barbarik
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_PORT=5432
# Used when invoking Python from the host, e.g. the seed script.
DATABASE_URL=postgresql+psycopg://barbarik:change-me-before-deploying@localhost:5432/barbarik_fitness
# Used by the backend container; Docker Compose overrides DATABASE_URL with this value.
DATABASE_URL_DOCKER=postgresql+psycopg://barbarik:change-me-before-deploying@postgres:5432/barbarik_fitness

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
APP_ENV=development
APP_NAME=Barbarik Fitness Pal
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Google Gemini agent provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_REQUEST_TIMEOUT_MS=15000

# Future Phase 1/2 integrations (not used by Phase 0)
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# Dashboard
VITE_API_BASE_URL=http://localhost:8000
